{
  "name": "hi-story",
  "version": "0.1.0",
  "description": "小说写作辅助工具",
  "main": "dist/main/main/index.js",
  "scripts": {
    "skills:sync": "node scripts/sync-writing-skills.js",
    "dev": "npm run electron:rebuild && concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json && electron .",
    "dev:renderer": "vite",
    "build:main": "tsc -p tsconfig.main.json && node scripts/copy-assets.js",
    "build:renderer": "vite build",
    "build": "npm run skills:sync && npm run build:main && npm run build:renderer",
    "test": "node scripts/run-tests.js",
    "test:watch": "vitest",
    "postinstall": "npm run build:main && npm run electron:rebuild",
    "electron:rebuild": "@electron/rebuild -f -w better-sqlite3",
    "start": "npm run electron:rebuild && electron ."
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.0",
    "node-gyp": "^13.0.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@tiptap/extension-character-count": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/extension-underline": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "better-sqlite3": "^12.1.0",
    "js-yaml": "^4.2.0",
    "openai": "^6.44.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^4.12.4",
    "uuid": "^10.0.0"
  }
}
